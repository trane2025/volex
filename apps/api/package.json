{
  "name": "api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "prisma generate",
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "test:auth": "node --import tsx --test tests/refresh-session.test.ts",
    "start": "node dist/index.js",
    "db:migrate": "RUST_LOG=info prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio --url=\"file://$PWD/dev.db\"",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "jose": "6.2.12",
    "socket.io": "4.8.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "26.5.0",
    "prettier": "3.9.6",
    "prisma": "7.10.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "description": "Backend-приложение Volex находится в `apps/api`.",
  "main": "index.js",
  "keywords": [],
  "author": "",
  "license": "ISC"
}
